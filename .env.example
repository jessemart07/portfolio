# Existing Web3Forms public access key. Configure in Vercel before deploying.
NEXT_PUBLIC_WEB_FORMS_API_KEY=
# Set true in preview deployments, leave unset for production.
NEXT_PUBLIC_NOINDEX=
# Optional legacy server API, unused by the main form. Requires a verified sender.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
